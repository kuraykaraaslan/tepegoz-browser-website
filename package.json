{
  "name": "tepegoz-website",
  "version": "0.1.0",
  "private": true,
  "description": "Static marketing site for Tepegöz — copy sourced from tepegoz-browser/docs/website, UI built on KUI React.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "kui:check": "node scripts/kui-check-imports.mjs",
    "kui:sync": "node scripts/kui-sync.mjs",
    "content:check": "node scripts/content-check.mjs",
    "check": "npm run kui:check && npm run content:check && npm run typecheck && npm run lint",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@kuraykaraaslan/kui-react": "file:vendor/kui-react",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "countries-list": "^3.3.0",
    "country-flag-icons": "^1.6.16",
    "iso-639-1": "^3.1.5",
    "leaflet": "^1.9.4",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
